{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "yiyuwebsite",
  "main": "worker.mjs",
  "compatibility_date": "2026-05-28",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/lead"]
  }
}
