<thead>
<tr>
<th>素材层级</th>
<th>内容类型</th>
<th>占比</th>
<th>测试预算</th>
</tr>
</thead>
<tbody>
<tr>
<td>钩子层</td>
<td>痛点场景/对比冲击</td>
