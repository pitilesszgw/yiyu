<!DOCTYPE html>
<html lang="zh-CN" x-data="appData()">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title x-text="t[lang].title">产品介绍 - 以渔数媒</title>
    <meta name="theme-color" content="#0f172a">
    <link rel="manifest" href="/static/manifest.webmanifest">
    <link rel="icon" href="/static/favicon.ico" sizes="any">
    <link rel="icon" type="image/png" href="/static/images/logo.png">
    <link rel="apple-touch-icon" href="/static/images/logo.png">
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/alpinejs@3.x.x/dist/cdn.min.js" defer></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <style>
        [x-cloak] { display: none !important; }
        body { overflow-x: hidden; }
        .video-stage {
            background:
                radial-gradient(circle at 18% 16%, rgba(37, 99, 235, 0.20), transparent 34%),
                radial-gradient(circle at 82% 28%, rgba(124, 58, 237, 0.16), transparent 34%),
                linear-gradient(180deg, #f8fafc 0%, #eef4ff 52%, #ffffff 100%);
        }
    </style>
</head>
<body class="font-sans text-slate-900 antialiased bg-white">
    <nav class="fixed w-full z-50 transition-all duration-300 bg-white/90 backdrop-blur-md border-b border-slate-100">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between h-20 items-center">
                <a href="/" class="flex-shrink-0 flex items-center gap-3 group">
                    <img src="/static/images/logo.png" alt="Logo" class="w-10 h-10 rounded-lg object-cover shadow-sm group-hover:shadow-md transition-shadow duration-300">
                    <span class="font-extrabold text-2xl tracking-tight bg-clip-text text-transparent bg-gradient-to-r from-blue-600 to-violet-600 drop-shadow-sm">以渔数媒</span>
                </a>

                <div class="hidden md:flex space-x-8 items-center">
                    <a href="/" class="text-sm font-medium text-slate-600 hover:text-blue-600 transition-colors" x-text="t[lang].nav.home">首页</a>
                    <a href="/product-intro" class="text-sm font-medium text-blue-600 transition-colors" x-text="t[lang].nav.product">产品介绍</a>
                    <a href="/articles" class="text-sm font-medium text-slate-600 hover:text-blue-600 transition-colors" x-text="t[lang].nav.articles">行业动态</a>
                    <a href="/tools" class="text-sm font-medium text-slate-600 hover:text-blue-600 transition-colors" x-text="t[lang].nav.tools">实用工具</a>
                    <a href="/pricing" class="text-sm font-medium text-slate-600 hover:text-blue-600 transition-colors" x-text="t[lang].nav.pricing">产品定价</a>

                    <button @click="toggleLang()" class="flex items-center space-x-1 px-3 py-1.5 rounded-md border border-slate-200 hover:border-blue-400 hover:bg-slate-50 transition-all">
                        <i class="fas fa-globe text-slate-500 text-xs"></i>
                        <span class="text-xs font-bold text-slate-600" x-text="lang === 'zh' ? 'EN' : '中'"></span>
                    </button>

                    <div class="flex items-center gap-3 pl-4 border-l border-slate-200">
                        <a href="/contact" class="px-5 py-2.5 rounded-lg bg-blue-600 text-white text-sm font-medium hover:bg-blue-700 transition-all shadow-md shadow-blue-500/20" x-text="t[lang].nav.contact">联系我们</a>
                    </div>
                </div>
            </div>
        </div>
    </nav>

    <main class="video-stage min-h-screen pt-24 pb-10 flex items-center">
        <div class="w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="relative">
                <div class="absolute -inset-3 sm:-inset-6 rounded-[2rem] bg-gradient-to-br from-blue-500/20 via-violet-500/20 to-cyan-400/20 blur-3xl"></div>
                <div class="relative rounded-3xl sm:rounded-[2rem] bg-slate-950 p-2 sm:p-3 shadow-2xl shadow-blue-950/25 border border-slate-800">
                    <video class="w-full max-h-[calc(100vh-9rem)] aspect-video object-contain rounded-[1.35rem] bg-black"
                           autoplay
                           muted
                           loop
                           controls
                           playsinline
                           preload="auto"
                           poster="/static/images/eyu-system-poster.png">
                        <source src="/static/videos/eyu-system-intro.mp4" type="video/mp4">
                    </video>
                </div>
            </div>
        </div>
    </main>

    <footer class="bg-slate-950 text-white border-t border-slate-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
        <div class="grid gap-8 lg:grid-cols-[1.35fr_0.65fr] lg:items-end">
            <div>
                <p class="text-lg font-bold">BRAVOTREE TECHNOLOGY LIMITED</p>
                <p class="mt-1 text-sm text-slate-400">奇樹科技有限公司</p>
                <p class="mt-4 max-w-3xl text-sm leading-6 text-slate-400">
                    以渔数媒（Yiyu Digital）由 BRAVOTREE TECHNOLOGY LIMITED 运营。香港公司编号：2972992。
                    yiyufish.com 为本公司官方网站。
                </p>
                <p class="mt-2 text-sm leading-6 text-slate-500">
                    Yiyu Digital is operated by BRAVOTREE TECHNOLOGY LIMITED, a company incorporated in Hong Kong. Company No. 2972992.
                </p>
            </div>
            <div class="lg:text-right">
                <a href="mailto:admin@yiyufish.com" class="inline-flex min-h-11 items-center rounded text-sm font-semibold text-blue-400 hover:text-blue-300 focus:outline-none focus:ring-2 focus:ring-blue-400 focus:ring-offset-2 focus:ring-offset-slate-950">
                    admin@yiyufish.com
                </a>
                <nav class="mt-3 flex flex-wrap gap-x-5 gap-y-3 text-sm text-slate-400 lg:justify-end" aria-label="公司与法律信息">
                    <a href="/about" class="hover:text-white">关于我们</a>
                    <a href="/contact" class="hover:text-white">联系我们</a>
                    <a href="/privacy" class="hover:text-white">隐私政策</a>
                    <a href="/terms" class="hover:text-white">服务条款</a>
                </nav>
            </div>
        </div>
        <div class="mt-8 border-t border-slate-800 pt-6 text-xs text-slate-500">
            &copy; 2026 BRAVOTREE TECHNOLOGY LIMITED. All rights reserved.
        </div>
    </div>
</footer>

    <script>
        const translations = {
            zh: {
                title: "产品介绍 - 以渔数媒",
                nav: {
                    home: "首页",
                    product: "产品介绍",
                    tools: "实用工具",
                    pricing: "产品定价",
                    articles: "行业动态",
                    contact: "联系我们"
                }
            },
            en: {
                title: "Product Intro - Yiyu Digital",
                nav: {
                    home: "Home",
                    product: "Product Intro",
                    tools: "Tools",
                    pricing: "Pricing",
                    articles: "Insights",
                    contact: "Contact Us"
                }
            }
        };

        function appData() {
            return {
                lang: localStorage.getItem('yiyu_lang') || 'zh',
                t: translations,
                toggleLang() {
                    this.lang = this.lang === 'zh' ? 'en' : 'zh';
                    localStorage.setItem('yiyu_lang', this.lang);
                }
            };
        }
    </script>
</body>
</html>